# Optional: enables the contact form to actually send an email via Resend
# (https://resend.com). Without this, submissions are validated and logged
# server-side but not emailed — the form still works end-to-end for visitors.
RESEND_API_KEY=

# Optional: the "from" address used when sending consultation request emails.
# Must be a domain verified in your Resend account.
CONTACT_FROM_EMAIL="Deolikar Wealth Website <onboarding@resend.dev>"
